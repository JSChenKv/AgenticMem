OLLAMA_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=bge-m3:latest
EMBED_DIMS=1024
CONTEXT_LENGTH=8192
SEED=42

# Optional task-agent CLIs. These use existing CLI login.
# Memory extraction follows the task agent by default; embeddings stay local.
# Set executable paths if they are not on PATH. Do not put access tokens here.
# CODEX_CLI_PATH=C:/path/to/codex.exe
# CLAUDE_CLI_PATH=C:/path/to/claude.exe
# CODEX_MODEL=
# CLAUDE_MODEL=
AGENT_TIMEOUT_SECONDS=300
# For direct Lab / legacy CLI use; web requests and benchmark flags specify these explicitly.
# AGENT_BACKEND=ollama
# AGENT_MODEL=
# MEMORY_BACKEND=follow
# MEMORY_MODEL=
